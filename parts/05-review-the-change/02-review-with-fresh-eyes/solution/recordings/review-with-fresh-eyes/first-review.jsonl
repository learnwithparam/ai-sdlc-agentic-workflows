{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qv7rLNvrc7mNZ6VZ7TeAtx","type":"tool_result","content":"// GET /crew/queue?depot=North: the open repair jobs a depot's crews work through, top first.\nimport type { Database } from \"bun:sqlite\";\nimport { brannockLabel, fromBrannockClock, toBrannockClock } from \"./brannock-time\";\n\nconst HOUR = 60 * 60 * 1000;\n\ntype JobRow = {\n  job_id: string;\n  bike_id: string;\n  station_id: string;\n  source: string;\n  fault: string;\n  reported_at: string;\n  opened_at: string;\n};\n\n// The contract limit: 48 hours for a wrench, 96 hours for a defect a crew found itself.\n// SLA-4: the clock starts when the defect is reported (the wrench), not when the dispatch\n// desk opens the job. Crews count the hours on the depot wall clock, so we do too.\nfunction contractDeadline(job: JobRow): string {\n  const limitHours = job.source === \"wrench\" ? 48 : 96;\n  const reportedOnTheWall = toBrannockClock(job.reported_at);\n  const deadlineOnTheWall = reportedOnTheWall + limitHours * HOUR;\n  return fromBrannockClock(deadlineOnTheWall);\n}\n\nfunction withDeadline(job: JobRow) {\n  const deadline = contractDeadline(job);\n  return { ...job, deadline, deadline_local: brannockLabel(deadline) };\n}\n\nexport function crewQueue(database: Database, depot: string | null) {\n  const jobs = database\n    .query(\"SELECT * FROM repair_jobs WHERE closed_at IS NULL AND (?1 IS NULL OR depot = ?1)\")\n    .all(depot) as JobRow[];\n  // The job due first goes on top. Ties keep the oldest job first.\n  const queue = jobs.map(withDeadline);\n  queue.sort(\n    (first, second) =>\n      Date.parse(first.deadline) - Date.parse(second.deadline) ||\n      first.opened_at.localeCompare(second.opened_at),\n  );\n  return { depot: depot ?? \"all\", jobs: queue };\n}","is_error":false}]},"parent_tool_use_id":"toolu_01CCPeEj4kziQq3XmRdFXL9G","agent_id":"aa975737ae9885ba7","session_id":"2224f79c-2ab4-4cc9-a55e-515fbe1ee521","uuid":"df726e3e-2db5-46a3-8764-8cb7c217f2d5","timestamp":"2026-11-13T05:23:28.738Z","tool_result_meta":[{"id":"toolu_01Qv7rLNvrc7mNZ6VZ7TeAtx","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}],"subagent_type":"reviewer","task_description":"Review local-deadlines branch"}
