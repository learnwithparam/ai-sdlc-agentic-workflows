{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PJRrhE6PWStPCmVwd2vFpD","type":"tool_result","content":"commit 51c399aa8caa2fa3d6c02f74924409530770a4cb\nAuthor: Sam Achebe <sam@kestrel.example>\nDate:   Mon Nov 2 18:30:00 2026 +0000\n\n    Show crews each deadline in Brannock time\n    \n    Crews plan shifts on the depot wall clock. The queue now gives\n    each job a deadline_local label, for example \"Sun 25 Oct, 14:05\".\n\n src/brannock-time.ts | 45 +++++++++++++++++++++++++++++++++++++++++++++\n src/crew-queue.ts    | 14 +++++++++++---\n 2 files changed, 56 insertions(+), 3 deletions(-)\ndiff --git a/src/brannock-time.ts b/src/brannock-time.ts\nnew file mode 100644\nindex 0000000..113da71\n--- /dev/null\n+++ b/src/brannock-time.ts\n@@ -0,0 +1,45 @@\n+// Brannock keeps UK time: GMT in winter, and one hour ahead (BST) in summer.\n+// Crews plan their shifts on the depot wall clock, so the queue speaks Brannock time.\n+const BRANNOCK_TIME_ZONE = \"Europe/London\";\n+\n+const wallClockFormat = new Intl.DateTimeFormat(\"en-GB\", {\n+  timeZone: BRANNOCK_TIME_ZONE,\n+  year: \"numeric\",\n+  month: \"2-digit\",\n+  day: \"2-digit\",\n+  hour: \"2-digit\",\n+  minute: \"2-digit\",\n+  second: \"2-digit\",\n+  hourCycle: \"h23\",\n+});\n+\n+const labelFormat = new Intl.DateTimeFormat(\"en-GB\", {\n+  timeZone: BRANNOCK_TIME_ZONE,\n+  weekday: \"short\",\n+  day: \"numeric\",\n+  month: \"short\",\n+  hour: \"2-digit\",\n+  minute: \"2-digit\",\n+});\n+\n+// The Brannock wall clock at one moment, written as if it were UTC.\n+// For example, 12:00 UTC in July reads 13:00 on the wall, so this gives 13:00.\n+export function toBrannockClock(isoTime: string): number {\n+  const moment = new Date(isoTime);\n+  const pieces = wallClockFormat.formatToParts(moment);\n+  const clock = Object.fromEntries(pieces.map((piece) => [piece.type, Number(piece.value)]));\n+  const timeOfDay = [clock.hour, clock.minute, clock.second, moment.getUTCMilliseconds()];\n+  return Date.UTC(clock.year, clock.month - 1, clock.day, ...timeOfDay);\n+}\n+\n+// From a Brannock wall clock time back to a real moment, as an ISO time in UTC.\n+export function fromBrannockClock(wallClock: number): string {\n+  const asIfUtc = new Date(wallClock).toISOString();\n+  const hoursAhead = toBrannockClock(asIfUtc) - wallClock;\n+  return new Date(wallClock - hoursAhead).toISOString();\n+}\n+\n+// What a crew reads on the queue screen, for example \"Sun 25 Oct, 14:05\".\n+export function brannockLabel(isoTime: string): string {\n+  return labelFormat.format(new Date(isoTime));\n+}\ndiff --git a/src/crew-queue.ts b/src/crew-queue.ts\nindex 0afb64e..37ebae2 100644\n--- a/src/crew-queue.ts\n+++ b/src/crew-queue.ts\n@@ -1,5 +1,6 @@\n // GET /crew/queue?depot=North: the open repair jobs a depot's crews work through, top first.\n import type { Database } from \"bun:sqlite\";\n+import { brannockLabel, fromBrannockClock, toBrannockClock } from \"./brannock-time\";\n \n const HOUR = 60 * 60 * 1000;\n \n@@ -15,10 +16,17 @@ type JobRow = {\n \n // The contract limit: 48 hours for a wrench, 96 hours for a defect a crew found itself.\n // SLA-4: the clock starts when the defect is reported (the wrench), not when the dispatch\n-// desk opens the job.\n+// desk opens the job. Crews count the hours on the depot wall clock, so we do too.\n function contractDeadline(job: JobRow): string {\n   const limitHours = job.source === \"wrench\" ? 48 : 96;\n-  return new Date(Date.parse(job.reported_at) + limitHours * HOUR).toISOString();\n+  const reportedOnTheWall = toBrannockClock(job.reported_at);\n+  const deadlineOnTheWall = reportedOnTheWall + limitHours * HOUR;\n+  return fromBrannockClock(deadlineOnTheWall);\n+}\n+\n+function withDeadline(job: JobRow) {\n+  const deadline = contractDeadline(job);\n+  return { ...job, deadline, deadline_local: brannockLabel(deadline) };\n }\n \n export function crewQueue(database: Database, depot: string | null) {\n@@ -26,7 +34,7 @@ export function crewQueue(database: Database, depot: string | null) {\n     .query(\"SELECT * FROM repair_jobs WHERE closed_at IS NULL AND (?1 IS NULL OR depot = ?1)\")\n     .all(depot) as JobRow[];\n   // The job due first goes on top. Ties keep the oldest job first.\n-  const queue = jobs.map((job) => ({ ...job, deadline: contractDeadline(job) }));\n+  const queue = jobs.map(withDeadline);\n   queue.sort(\n     (first, second) =>\n       Date.parse(first.deadline) - Date.parse(second.deadline) ||","is_error":false}]},"parent_tool_use_id":"toolu_01CCPeEj4kziQq3XmRdFXL9G","agent_id":"aa975737ae9885ba7","session_id":"2224f79c-2ab4-4cc9-a55e-515fbe1ee521","uuid":"1154a0a6-51eb-4610-a4aa-cb87ae357043","timestamp":"2026-11-13T05:23:20.877Z","tool_result_meta":[{"id":"toolu_01PJRrhE6PWStPCmVwd2vFpD","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}],"subagent_type":"reviewer","task_description":"Review local-deadlines branch"}
