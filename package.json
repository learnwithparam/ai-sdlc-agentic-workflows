{
  "name": "ai-sdlc-agentic-workflows",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun scripts/readable.ts && bun scripts/plain-english.ts && bun scripts/check.ts && bun scripts/verify.ts --all && bun scripts/audit.ts",
    "readable": "bun scripts/readable.ts",
    "plain-english": "bun scripts/plain-english.ts",
    "format": "biome check --write .",
    "verify": "bun scripts/verify.ts",
    "start": "bun scripts/start.ts begin",
    "catch-up": "bun scripts/start.ts end",
    "world": "bun scripts/world.ts",
    "doctor": "bun scripts/doctor.ts",
    "approve": "bun scripts/approve.ts",
    "record": "bun scripts/record.ts",
    "finished": "bun world/finished.ts",
    "scorecard": "bun scripts/scorecard.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.63.0"
  }
}
